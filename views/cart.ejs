<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Cart - Saree Shop</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: Arial, sans-serif;
      background: #f7f3ef;
      margin: 0;
    }
    nav {
      background: #7a1f2b;
      color: #fff;
      padding: 15px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    nav a {
      color: #fff;
      text-decoration: none;
      font-size: 14px;
      margin-left: 15px;
    }
    .container {
      max-width: 700px;
      margin: 30px auto;
      padding: 0 20px;
    }
    .item {
      background: #fff;
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 12px;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.08);
      margin-bottom: 15px;
    }
    .item img {
      width: 70px;
      height: 70px;
      object-fit: cover;
      border-radius: 6px;
    }
    .item-info {
      flex: 1;
    }
    .item-info h3 {
      margin: 0 0 5px;
      font-size: 15px;
    }
    .item-info .price {
      font-size: 14px;
      color: #7a1f2b;
      font-weight: bold;
    }
    .remove-btn {
      background: none;
      border: 1px solid #7a1f2b;
      color: #7a1f2b;
      padding: 6px 12px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 13px;
    }
    .remove-btn:hover {
      background: #7a1f2b;
      color: #fff;
    }
    .total {
      background: #fff;
      padding: 15px;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.08);
      text-align: right;
      font-size: 16px;
      font-weight: bold;
      color: #7a1f2b;
    }
    .empty {
      text-align: center;
      color: #777;
      margin-top: 50px;
    }
  </style>
</head>
<body>
  <nav>
    <span>Saree Shop</span>
    <div>
      <a href="/shop">Shop</a>
      <a href="/users/logout">Logout</a>
    </div>
  </nav>

  <div class="container">
    <% if (cart.length === 0) { %>
      <p class="empty">Your cart is empty.</p>
    <% } else { %>
      <% let total = 0; %>
      <% cart.forEach(function(product) { %>
        <% let finalPrice = product.price - (product.price * product.discount / 100); %>
        <% total += finalPrice; %>
        <div class="item">
          <img src="data:image/png;base64,<%= product.image %>" alt="<%= product.name %>">
          <div class="item-info">
            <h3><%= product.name %></h3>
            <div class="price">₹<%= finalPrice.toFixed(0) %></div>
          </div>
          <form action="/users/cart/remove/<%= product._id %>" method="POST">
            <button class="remove-btn" type="submit">Remove</button>
          </form>
        </div>
      <% }) %>

      <div class="total">Total: ₹<%= total.toFixed(0) %></div>
    <% } %>
  </div>
</body>
</html>
