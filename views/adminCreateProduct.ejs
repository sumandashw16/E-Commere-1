<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin - Create Product</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: Arial, sans-serif;
      background: #f7f3ef;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      padding: 20px 0;
    }
    .card {
      background: #fff;
      padding: 30px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      width: 380px;
    }
    h2 {
      text-align: center;
      color: #7a1f2b;
      margin-bottom: 20px;
    }
    h4 {
      color: #7a1f2b;
      margin: 15px 0 5px;
      border-bottom: 1px solid #eee;
      padding-bottom: 5px;
    }
    label {
      font-size: 13px;
      color: #444;
      display: block;
      margin-top: 8px;
    }
    input[type="text"],
    input[type="number"],
    input[type="file"] {
      width: 100%;
      padding: 10px;
      margin: 6px 0;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 14px;
    }
    input[type="color"] {
      width: 100%;
      height: 38px;
      margin: 6px 0;
      border: 1px solid #ccc;
      border-radius: 4px;
      padding: 2px;
    }
    button {
      width: 100%;
      padding: 10px;
      background: #7a1f2b;
      color: #fff;
      border: none;
      border-radius: 4px;
      margin-top: 15px;
      cursor: pointer;
      font-size: 15px;
    }
    button:hover { background: #601722; }
  </style>
</head>
<body>
  <div class="card">
    <% if (success.length > 0) { %>
      <p style="color: green; text-align: center;"><%= success[0] %></p>
    <% } %>
    <h2>Create Product</h2>
    <form action="/products/create" method="POST" enctype="multipart/form-data">

      <h4>Product Details</h4>
      <label>Product Image</label>
      <input type="file" name="image" accept="image/*" required>

      <label>Product Name</label>
      <input type="text" name="name" placeholder="Product Name" required>

      <label>Price</label>
      <input type="number" name="price" placeholder="Price" required>

      <label>Discount (%)</label>
      <input type="number" name="discount" placeholder="Discount">

      <h4>Panel Details</h4>
      <label>Background Color</label>
      <input type="color" name="bgcolor" value="#f7f3ef">

      <label>Panel Color</label>
      <input type="color" name="panelcolor" value="#ffffff">

      <label>Text Color</label>
      <input type="color" name="textcolor" value="#7a1f2b">

      <button type="submit">Create Product</button>
    </form>
  </div>
</body>
</html>
